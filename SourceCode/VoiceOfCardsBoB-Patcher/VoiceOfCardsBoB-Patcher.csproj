<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoiceOfCardsBoB_CN_Patch</AssemblyName>
    <RootNamespace>VoiceOfCardsPatch</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\Release\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
	<EmbeddedResource Include="..\..\GeneratedGameFiles\asset_text_en" LogicalName="Patch.asset_text_en" />
	<EmbeddedResource Include="..\..\GeneratedGameFiles\localization-string-tables-english(en)_assets_all.bundle" LogicalName="Patch.localization-string-tables-english(en)_assets_all.bundle" />
	<EmbeddedResource Include="..\..\GeneratedGameFiles\sharedassets0.assets" LogicalName="Patch.sharedassets0.assets" />
	<EmbeddedResource Include="..\..\GeneratedGameFiles\sharedassets0.assets.resS" LogicalName="Patch.sharedassets0.assets.resS" />
  </ItemGroup>
  <Target Name="ValidatePatchFiles" BeforeTargets="Publish">
    <Error Condition="!Exists('..\..\GeneratedGameFiles\asset_text_en')" Text="GeneratedGameFiles\asset_text_en is missing. Run the localization tool and generate game files first." />
    <Error Condition="!Exists('..\..\GeneratedGameFiles\localization-string-tables-english(en)_assets_all.bundle')" Text="GeneratedGameFiles\localization-string-tables-english(en)_assets_all.bundle is missing. Run the localization tool and generate game files first." />
  </Target>
</Project>
